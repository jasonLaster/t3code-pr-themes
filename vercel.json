{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/contributors",
      "destination": "/index.html"
    },
    {
      "source": "/marketing",
      "destination": "/index.html"
    },
    {
      "source": "/marketing/:slug",
      "destination": "/marketing/:slug/index.html"
    }
  ]
}
